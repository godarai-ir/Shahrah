{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "GodarAI Contemporary Geometric Lithography",
  "version": "1.0.0",
  "updated": "2026-08-07",
  "direction": "rtl",
  "brandName": {
    "fa": "گدارAI",
    "latin": "GodarAI"
  },
  "style": {
    "name": "Contemporary Geometric Lithography",
    "nameFa": "چاپ‌سنگی هندسی معاصر",
    "status": "primary",
    "personality": [
      "intelligent-not-cold",
      "precise-not-dry",
      "artistic-not-decorative",
      "premium-not-luxurious",
      "abstract-not-meaningless",
      "calm-deep-reflective"
    ]
  },
  "color": {
    "deepNavy": "#06182D",
    "darkBlue": "#012651",
    "cyan": "#00C9EB",
    "mutedCobalt": null,
    "paleIcyBlue": "#D9EEFF",
    "warmOffWhite": "#F6FBFF",
    "mutedViolet": null,
    "usagePercent": {
      "navyAndDarkBlue": [60, 70],
      "warmOffWhiteAndNeutrals": [20, 30],
      "cyanMaximum": 10,
      "mutedViolet": "details-only"
    }
  },
  "form": {
    "allowed": [
      "large-circles-and-semicircles",
      "rectangles-and-flat-planes",
      "geometric-cuts",
      "thick-arcs",
      "overlapping-layers",
      "incomplete-frames",
      "engraved-lines",
      "hatching-and-parallel-lines",
      "printed-plates-and-inked-surfaces"
    ],
    "primaryFormCount": [3, 5],
    "oneDominantForm": true,
    "flatGraphicControlled": true
  },
  "texture": {
    "required": [
      "warm-matte-paper",
      "fine-ink-grain",
      "hand-hatching",
      "subtle-print-misregistration",
      "slightly-rough-edges",
      "minor-ink-density-variation",
      "ink-pressure-transfer"
    ],
    "target": "contemporary-hand-print",
    "avoid": ["dirty", "aged", "vintage-nostalgia"]
  },
  "composition": {
    "generousNegativeSpace": true,
    "forcedSymmetry": false,
    "edgeCropping": true,
    "permanentCentering": false,
    "flatEditorial": true
  },
  "depth": {
    "matte": true,
    "limited": true,
    "allowed": ["very-soft-flat-shadows", "subtle-ink-layer-difference"],
    "forbidden": [
      "cinematic-lighting",
      "glossy-reflections",
      "transparent-glass",
      "chrome",
      "volumetric-light",
      "neon",
      "strong-realistic-shadows"
    ]
  },
  "forbiddenConcepts": [
    "gateway",
    "portal",
    "bridge",
    "road",
    "path",
    "route",
    "flow",
    "stream",
    "river",
    "wave",
    "glowing-focal-point",
    "light-dots",
    "stars",
    "nodes",
    "network",
    "circuitry",
    "robot",
    "brain",
    "globe",
    "shield",
    "lock",
    "hologram",
    "generic-ai-imagery",
    "motion",
    "transition",
    "chaos-versus-order",
    "glossy-3d",
    "photorealism",
    "text-in-base-image",
    "watermark"
  ],
  "signatureMinimumCount": 3,
  "signature": [
    "deep-navy-background",
    "flat-geometric-forms",
    "engraved-lines",
    "hand-print-texture",
    "cyan-as-ink-layer",
    "incomplete-border-or-crop",
    "significant-negative-space",
    "restrained-palette",
    "contemporary-art-print-feel"
  ],
  "typography": {
    "persian": "Vazirmatn",
    "technical": "JetBrains Mono",
    "baseImageContainsText": false
  },
  "formats": {
    "feedPortrait": { "width": 1200, "height": 1500, "ratio": "4:5" },
    "feedSquare": { "width": 1200, "height": 1200, "ratio": "1:1" },
    "articleLandscape": { "width": 1200, "height": 630, "ratio": "1.91:1" },
    "storyReel": { "width": 1080, "height": 1920, "ratio": "9:16" }
  },
  "exploratoryDirections": [
    "Minimal Digital Painting",
    "Contemporary Watercolor",
    "Contemporary Material Abstraction",
    "Stone Texture Variant"
  ],
  "archive": {
    "promptFile": "PROMPTS.md",
    "moodboardIndex": "moodboards/README.md",
    "originalImageDirectory": "moodboards/originals"
  }
}
