{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "GodarAI Social Media Visual System",
  "version": "1.0.0",
  "updated": "2026-08-06",
  "direction": "rtl",
  "brandName": {
    "fa": "گدارAI",
    "latin": "GodarAI"
  },
  "concept": {
    "promise": "کنترل هوشمند جریان AI",
    "layers": [
      "flow",
      "control",
      "clarity"
    ],
    "visualDirection": [
      "Intelligent Flow",
      "Editorial Technology"
    ]
  },
  "color": {
    "brand": {
      "cyan": "#00C9EB",
      "cyanBright": "#05D1EE",
      "cyanDeep": "#00BCE1",
      "navy": "#012651",
      "navyTop": "#022A57",
      "navyBottom": "#011D40",
      "darkBackground": "#06182D",
      "offWhite": "#F6FBFF",
      "ice": "#D9EEFF",
      "white": "#FFFFFF"
    },
    "role": {
      "darkCanvas": "#06182D",
      "darkTextPrimary": "#F6FBFF",
      "darkTextSecondary": "#D9EEFF",
      "darkAccent": "#00C9EB",
      "lightCanvas": "#F6FBFF",
      "lightTextPrimary": "#012651",
      "lightAccentDecorativeOnly": "#00C9EB"
    },
    "contrast": {
      "cyanOnDarkBackground": 8.97,
      "cyanOnNavy": 7.55,
      "cyanOnWhite": 1.99,
      "navyOnWhite": 15.03,
      "iceOnDarkBackground": 14.98,
      "offWhiteOnDarkBackground": 17.14,
      "minimumText": 4.5,
      "minimumMeaningfulGraphic": 3.0
    }
  },
  "typography": {
    "persian": {
      "family": "Vazirmatn",
      "fallback": [
        "Tahoma",
        "Arial",
        "sans-serif"
      ],
      "weights": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700,
        "extrabold": 800,
        "black": 900
      }
    },
    "technical": {
      "family": "JetBrains Mono",
      "fallback": [
        "Consolas",
        "monospace"
      ],
      "direction": "ltr"
    },
    "scale1200x1500": {
      "heroNumberPx": [
        144,
        200
      ],
      "headlinePx": [
        76,
        96
      ],
      "carouselTitlePx": [
        56,
        72
      ],
      "subtitlePx": [
        40,
        48
      ],
      "bodyPx": [
        30,
        36
      ],
      "labelPx": [
        24,
        28
      ],
      "footnotePx": [
        20,
        24
      ],
      "minimumBodyPx": 28
    }
  },
  "logo": {
    "source": "web-assets/svg",
    "intrinsicRatio": {
      "width": 336,
      "height": 247
    },
    "defaultPlacement": "top-left",
    "alternatePlacement": "bottom-left-signature",
    "clearSpace": "0.25x logo height",
    "master1200x1500": {
      "preferredHeightPx": 72,
      "minimumHeightPx": 56
    },
    "master1200x1200": {
      "preferredHeightPx": 64,
      "minimumHeightPx": 48
    },
    "variants": {
      "lightCanvas": "godarai-mark-light.svg",
      "darkCanvas": "godarai-mark-dark.svg",
      "monoLightCanvas": "godarai-mark-mono-navy.svg",
      "monoDarkCanvas": "godarai-mark-mono-white.svg"
    }
  },
  "layout": {
    "baseGridPx": 4,
    "spacingPx": [
      8,
      12,
      16,
      24,
      32,
      48,
      64,
      96
    ],
    "radiusPx": [
      12,
      16,
      24
    ],
    "master1200x1500": {
      "widthPx": 1200,
      "heightPx": 1500,
      "columns": 12,
      "marginPx": 96,
      "gutterPx": 24,
      "signatureBandMaxPx": 120
    },
    "master1200x1200": {
      "widthPx": 1200,
      "heightPx": 1200,
      "columns": 12,
      "marginPx": 84,
      "gutterPx": 24
    },
    "textVisualRatio": "60:40"
  },
  "format": {
    "feedPortrait": {
      "widthPx": 1200,
      "heightPx": 1500,
      "ratio": "4:5"
    },
    "feedSquare": {
      "widthPx": 1200,
      "heightPx": 1200,
      "ratio": "1:1"
    },
    "openGraph": {
      "widthPx": 1200,
      "heightPx": 630,
      "ratio": "1.91:1"
    },
    "storyReel": {
      "widthPx": 1080,
      "heightPx": 1920,
      "ratio": "9:16",
      "safeAreaHouseRulePx": {
        "top": 250,
        "right": 120,
        "bottom": 320,
        "left": 120
      }
    },
    "linkedinDocument": {
      "preferredRatio": "4:5",
      "houseRulePages": {
        "minimum": 6,
        "maximum": 12
      },
      "officialLimitMb": 100,
      "officialLimitPages": 300,
      "allPagesSameSize": true,
      "preferredFormat": "pdf"
    }
  },
  "flowMotif": {
    "maximumPrimaryPaths": 5,
    "maximumHighlightedPaths": 1,
    "crossingRequiresNode": true,
    "avoidBehindDenseText": true,
    "defaultNarrativeDirection": "right-to-left"
  },
  "templates": [
    "S01-single-post",
    "S02-carousel-cover",
    "S03-carousel-inner",
    "S04-feature",
    "S05-comparison",
    "S06-quote",
    "S07-data",
    "S08-release",
    "S09-provider-model",
    "S10-event",
    "S11-video-cover",
    "S12-demo-cta"
  ],
  "export": {
    "colorProfile": "sRGB",
    "staticPreferred": [
      "png",
      "jpg"
    ],
    "carouselPreferred": "pdf",
    "fileNamePattern": "YYYY-MM-DD_platform_template_topic_lang_version.ext"
  },
  "governance": {
    "variableClaimsRequireDatedSource": true,
    "templatePromotionMinimumReuseCount": 3,
    "realContentPilotCount": {
      "minimum": 10,
      "maximum": 15
    },
    "reviewCadence": "quarterly"
  }
}
