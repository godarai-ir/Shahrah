{
  "info": {
    "_postman_id": "76359fe7-7635-9fe7-7635-76359fe77635",
    "name": "GodarAI - xAI four-model conformance",
    "description": "Credential-gated GodarAI contract checks for grok-4.3, grok-4.5, grok-imagine-image, and grok-imagine-image-quality. Requests use only a GodarAI virtual key; never place XAI_API_KEY in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{godarai_api_key}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('godarai_api_key')) { throw new Error('godarai_api_key is required'); }",
          "if (!pm.collectionVariables.get('provider_account_id')) { throw new Error('Set provider_account_id before running xAI conformance'); }"
        ]
      }
    }
  ],
  "variable": [
    { "key": "provider_slug", "value": "xai", "type": "string" },
    { "key": "provider_model_count", "value": "4", "type": "string" },
    { "key": "provider_account_id", "value": "", "type": "string" },
    { "key": "grok_43_model", "value": "grok-4.3", "type": "string" },
    { "key": "grok_45_model", "value": "grok-4.5", "type": "string" },
    { "key": "imagine_model", "value": "grok-imagine-image", "type": "string" },
    { "key": "imagine_quality_model", "value": "grok-imagine-image-quality", "type": "string" }
  ],
  "item": [
    {
      "name": "Discovery",
      "item": [
        {
          "name": "List exactly the four target models",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/v1/models"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.response.to.have.status(200);",
              "const body = pm.response.json();",
              "const ids = (body.data || body.models || body).map(x => x.id || x.modelId);",
              "['grok-4.3','grok-4.5','grok-imagine-image','grok-imagine-image-quality'].forEach(id => pm.expect(ids).to.include(id));"
            ] }
          }]
        }
      ]
    },
    {
      "name": "Text models",
      "item": [
        {
          "name": "grok-4.3 Chat",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-godarai-provider", "value": "xai" },
              { "key": "x-godarai-provider-account", "value": "{{provider_account_id}}" },
              { "key": "x-grok-conv-id", "value": "postman-grok-43" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"model\": \"{{grok_43_model}}\",\n  \"messages\": [{\"role\":\"user\",\"content\":\"Reply with OK.\"}],\n  \"reasoning_effort\": \"none\",\n  \"max_tokens\": 8\n}" },
            "url": "{{base_url}}/v1/chat/completions"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(200);", "pm.expect(pm.response.json().usage.cost_in_usd_ticks).to.be.a('number');"] } }]
        },
        {
          "name": "grok-4.5 Chat reasoning",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-godarai-provider", "value": "xai" },
              { "key": "x-godarai-provider-account", "value": "{{provider_account_id}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"model\": \"{{grok_45_model}}\",\n  \"messages\": [{\"role\":\"user\",\"content\":\"Reply with OK.\"}],\n  \"reasoning_effort\": \"low\",\n  \"max_tokens\": 8\n}" },
            "url": "{{base_url}}/v1/chat/completions"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(200);", "pm.expect(pm.response.json().usage.cost_in_usd_ticks).to.be.a('number');"] } }]
        },
        {
          "name": "grok-4.5 rejects incompatible sampling",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-godarai-provider", "value": "xai" },
              { "key": "x-godarai-provider-account", "value": "{{provider_account_id}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"model\": \"{{grok_45_model}}\",\n  \"messages\": [],\n  \"reasoning_effort\": \"low\",\n  \"presence_penalty\": 0.1\n}" },
            "url": "{{base_url}}/v1/chat/completions"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.expect(pm.response.code).to.be.oneOf([400,422]);"] } }]
        },
        {
          "name": "grok-4.3 Responses",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-godarai-provider", "value": "xai" },
              { "key": "x-godarai-provider-account", "value": "{{provider_account_id}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"model\": \"{{grok_43_model}}\",\n  \"input\": \"Reply with OK.\",\n  \"max_output_tokens\": 8\n}" },
            "url": "{{base_url}}/v1/responses"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(200);", "pm.expect(pm.response.json().usage.cost_in_usd_ticks).to.be.a('number');"] } }]
        },
        {
          "name": "grok-4.5 Responses compaction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-godarai-provider", "value": "xai" },
              { "key": "x-godarai-provider-account", "value": "{{provider_account_id}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"model\": \"{{grok_45_model}}\",\n  \"input\": [{\"role\":\"user\",\"content\":\"Remember that the code is 42.\"}]\n}" },
            "url": "{{base_url}}/v1/responses/compact"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(200);"] } }]
        }
      ]
    },
    {
      "name": "Image models",
      "item": [
        {
          "name": "Imagine 1K base64 generation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-godarai-provider", "value": "xai" },
              { "key": "x-godarai-provider-account", "value": "{{provider_account_id}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"model\": \"{{imagine_model}}\",\n  \"prompt\": \"A small blue circle on white\",\n  \"n\": 1,\n  \"resolution\": \"1k\",\n  \"aspect_ratio\": \"1:1\",\n  \"response_format\": \"b64_json\"\n}" },
            "url": "{{base_url}}/v1/images/generations"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(200);", "const body=pm.response.json();", "pm.expect(body.data[0].b64_json).to.be.a('string');"] } }]
        },
        {
          "name": "Imagine Quality 2K URL generation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-godarai-provider", "value": "xai" },
              { "key": "x-godarai-provider-account", "value": "{{provider_account_id}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"model\": \"{{imagine_quality_model}}\",\n  \"prompt\": \"A small blue circle on white\",\n  \"n\": 1,\n  \"resolution\": \"2k\",\n  \"aspect_ratio\": \"1:1\",\n  \"response_format\": \"url\"\n}" },
            "url": "{{base_url}}/v1/images/generations"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(200);", "const body=pm.response.json();", "pm.expect(body.data[0].url).to.be.a('string');"] } }]
        },
        {
          "name": "xAI multipart edits rejected locally",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-godarai-provider", "value": "xai" },
              { "key": "x-godarai-provider-account", "value": "{{provider_account_id}}" }
            ],
            "body": { "mode": "formdata", "formdata": [
              { "key": "model", "value": "{{imagine_model}}", "type": "text" },
              { "key": "prompt", "value": "edit", "type": "text" }
            ] },
            "url": "{{base_url}}/v1/images/edits"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.expect(pm.response.code).to.be.oneOf([400,415,422]);"] } }]
        }
      ]
    },
    {
      "name": "Resources",
      "item": [
        {
          "name": "List xAI Files",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-godarai-provider", "value": "xai" },
              { "key": "x-godarai-provider-account", "value": "{{provider_account_id}}" }
            ],
            "url": "{{base_url}}/v1/files?limit=10"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(200);"] } }]
        },
        {
          "name": "xAI Batch is fail-closed pending settlement",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-godarai-provider", "value": "xai" },
              { "key": "x-godarai-provider-account", "value": "{{provider_account_id}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\":\"godarai-postman-conformance\"}" },
            "url": "{{base_url}}/v1/batches"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(503);", "pm.expect(pm.response.json().error.type).to.eql('billing_unavailable');"] } }]
        }
      ]
    }
  ]
}
