{
  "info": {
    "_postman_id": "43270978-4327-0978-4327-432709784327",
    "name": "GodarAI - Google Gemini",
    "description": "Executable Gemini Developer API and Google OpenAI-compatibility smoke collection for the curated nine-model set. Uses only GodarAI credentials; provider secrets remain server-side.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{godarai_api_key}}","type":"string"}]},
  "event": [{"listen":"prerequest","script":{"type":"text/javascript","exec":["const required=['base_url','tenant_slug','godarai_api_key','provider_account_id'];","const missing=required.filter(k=>!pm.variables.get(k));","if(missing.length){throw new Error(`Missing variables: ${missing.join(', ')}`);}"]}}],
  "variable": [
    {"key":"provider_slug","value":"google-gemini"},
    {"key":"provider_model_count","value":"9"},
    {"key":"provider_account_id","value":""},
    {"key":"text_model","value":"gemini-3.6-flash"},
    {"key":"image_model","value":"gemini-3.1-flash-image"},
    {"key":"tts_model","value":"gemini-3.1-flash-tts-preview"},
    {"key":"embedding_model","value":"gemini-embedding-2"},
    {"key":"interaction_id","value":""},
    {"key":"file_id","value":""},
    {"key":"cache_id","value":""},
    {"key":"batch_id","value":""},
    {"key":"model_fqn_chat","value":"google-gemini:{{provider_account_id}}:{{text_model}}"},
    {"key":"model_fqn_embedding","value":"google-gemini:{{provider_account_id}}:{{embedding_model}}"},
    {"key":"model_fqn_image","value":"google-gemini:{{provider_account_id}}:{{image_model}}"}
  ],
  "item": [
    {"name":"Native Models","item":[
      {"name":"List curated models","request":{"method":"GET","header":[{"key":"x-godarai-tenant","value":"{{tenant_slug}}"},{"key":"x-godarai-provider-account","value":"{{provider_account_id}}"}],"url":"{{base_url}}/v1beta/models"}},
      {"name":"Get one model","request":{"method":"GET","header":[{"key":"x-godarai-tenant","value":"{{tenant_slug}}"},{"key":"x-godarai-provider-account","value":"{{provider_account_id}}"}],"url":"{{base_url}}/v1beta/models/{{text_model}}"}}
    ]},
    {"name":"Native Generate Content","item":[
      {"name":"Multimodal generateContent","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"x-godarai-tenant","value":"{{tenant_slug}}"},{"key":"x-godarai-provider-account","value":"{{provider_account_id}}"}],"body":{"mode":"raw","raw":"{\n  \"contents\": [{\"role\": \"user\", \"parts\": [{\"text\": \"Reply with JSON containing ok=true\"}]}],\n  \"generationConfig\": {\"responseMimeType\": \"application/json\", \"responseSchema\": {\"type\": \"OBJECT\", \"properties\": {\"ok\": {\"type\": \"BOOLEAN\"}}}},\n  \"tools\": [{\"functionDeclarations\": [{\"name\": \"clock\", \"parameters\": {\"type\": \"OBJECT\", \"properties\": {}}}]}]\n}"},"url":"{{base_url}}/v1beta/models/{{text_model}}:generateContent"}},
      {"name":"SSE streamGenerateContent","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Accept","value":"text/event-stream"},{"key":"x-godarai-tenant","value":"{{tenant_slug}}"},{"key":"x-godarai-provider-account","value":"{{provider_account_id}}"}],"body":{"mode":"raw","raw":"{\"contents\":[{\"parts\":[{\"text\":\"Count to three\"}]}]}"},"url":"{{base_url}}/v1beta/models/{{text_model}}:streamGenerateContent?alt=sse"}},
      {"name":"countTokens","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"x-godarai-tenant","value":"{{tenant_slug}}"},{"key":"x-godarai-provider-account","value":"{{provider_account_id}}"}],"body":{"mode":"raw","raw":"{\"contents\":[{\"parts\":[{\"text\":\"Count these tokens\"}]}]}"},"url":"{{base_url}}/v1beta/models/{{text_model}}:countTokens"}},
      {"name":"Native image generation/editing","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"x-godarai-tenant","value":"{{tenant_slug}}"},{"key":"x-godarai-provider-account","value":"{{provider_account_id}}"}],"body":{"mode":"raw","raw":"{\"contents\":[{\"parts\":[{\"text\":\"Create a small blue circle on white\"}]}],\"generationConfig\":{\"responseModalities\":[\"TEXT\",\"IMAGE\"]}}"},"url":"{{base_url}}/v1beta/models/{{image_model}}:generateContent"}},
      {"name":"Native TTS","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"x-godarai-tenant","value":"{{tenant_slug}}"},{"key":"x-godarai-provider-account","value":"{{provider_account_id}}"}],"body":{"mode":"raw","raw":"{\"contents\":[{\"parts\":[{\"text\":\"Say: Gemini audio smoke test\"}]}],\"generationConfig\":{\"responseModalities\":[\"AUDIO\"],\"speechConfig\":{\"voiceConfig\":{\"prebuiltVoiceConfig\":{\"voiceName\":\"Kore\"}}}}}"},"url":"{{base_url}}/v1beta/models/{{tts_model}}:generateContent"}}
    ]},
    {"name":"Interactions","item":[
      {"name":"Create stateless interaction","event":[{"listen":"test","script":{"exec":["if(pm.response.code<300){const b=pm.response.json();if(b.id)pm.collectionVariables.set('interaction_id',b.id.replace('interactions/',''));}"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"x-godarai-tenant","value":"{{tenant_slug}}"},{"key":"x-godarai-provider-account","value":"{{provider_account_id}}"}],"body":{"mode":"raw","raw":"{\"model\":\"{{text_model}}\",\"input\":\"Hello from Interactions\"}"},"url":"{{base_url}}/v1beta/interactions"}},
      {"name":"Get interaction","request":{"method":"GET","header":[{"key":"x-godarai-tenant","value":"{{tenant_slug}}"},{"key":"x-godarai-provider-account","value":"{{provider_account_id}}"}],"url":"{{base_url}}/v1beta/interactions/{{interaction_id}}"}},
      {"name":"Cancel interaction","request":{"method":"POST","header":[{"key":"x-godarai-tenant","value":"{{tenant_slug}}"},{"key":"x-godarai-provider-account","value":"{{provider_account_id}}"}],"url":"{{base_url}}/v1beta/interactions/{{interaction_id}}:cancel"}},
      {"name":"Delete interaction","request":{"method":"DELETE","header":[{"key":"x-godarai-tenant","value":"{{tenant_slug}}"},{"key":"x-godarai-provider-account","value":"{{provider_account_id}}"}],"url":"{{base_url}}/v1beta/interactions/{{interaction_id}}"}}
    ]},
    {"name":"Embeddings","item":[
      {"name":"Native multimodal embedContent","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"x-godarai-tenant","value":"{{tenant_slug}}"},{"key":"x-godarai-provider-account","value":"{{provider_account_id}}"}],"body":{"mode":"raw","raw":"{\"content\":{\"parts\":[{\"text\":\"Embedding smoke test\"}]},\"outputDimensionality\":768}"},"url":"{{base_url}}/v1beta/models/{{embedding_model}}:embedContent"}},
      {"name":"Native batchEmbedContents","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"x-godarai-tenant","value":"{{tenant_slug}}"},{"key":"x-godarai-provider-account","value":"{{provider_account_id}}"}],"body":{"mode":"raw","raw":"{\"requests\":[{\"model\":\"models/{{embedding_model}}\",\"content\":{\"parts\":[{\"text\":\"first\"}]}},{\"model\":\"models/{{embedding_model}}\",\"content\":{\"parts\":[{\"text\":\"second\"}]}}]}"},"url":"{{base_url}}/v1beta/models/{{embedding_model}}:batchEmbedContents"}}
    ]},
    {"name":"Native Resources","item":[
      {"name":"List files","request":{"method":"GET","header":[{"key":"x-godarai-tenant","value":"{{tenant_slug}}"},{"key":"x-godarai-provider-account","value":"{{provider_account_id}}"}],"url":"{{base_url}}/v1beta/files"}},
      {"name":"Create context cache","event":[{"listen":"test","script":{"exec":["if(pm.response.code<300){const b=pm.response.json();if(b.name)pm.collectionVariables.set('cache_id',b.name.replace('cachedContents/',''));}"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"x-godarai-tenant","value":"{{tenant_slug}}"},{"key":"x-godarai-provider-account","value":"{{provider_account_id}}"}],"body":{"mode":"raw","raw":"{\"model\":\"models/{{text_model}}\",\"contents\":[{\"parts\":[{\"text\":\"Reusable context\"}]}],\"ttl\":\"300s\"}"},"url":"{{base_url}}/v1beta/cachedContents"}},
      {"name":"List caches","request":{"method":"GET","header":[{"key":"x-godarai-tenant","value":"{{tenant_slug}}"},{"key":"x-godarai-provider-account","value":"{{provider_account_id}}"}],"url":"{{base_url}}/v1beta/cachedContents"}},
      {"name":"Delete cache","request":{"method":"DELETE","header":[{"key":"x-godarai-tenant","value":"{{tenant_slug}}"},{"key":"x-godarai-provider-account","value":"{{provider_account_id}}"}],"url":"{{base_url}}/v1beta/cachedContents/{{cache_id}}"}},
      {"name":"Create Batch API job","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"x-godarai-tenant","value":"{{tenant_slug}}"},{"key":"x-godarai-provider-account","value":"{{provider_account_id}}"}],"body":{"mode":"raw","raw":"{\"batch\":{\"displayName\":\"postman-smoke\",\"inputConfig\":{\"requests\":{\"requests\":[{\"request\":{\"contents\":[{\"parts\":[{\"text\":\"hello\"}]}]}}]}}}}"},"url":"{{base_url}}/v1beta/models/{{text_model}}:batchGenerateContent"}},
      {"name":"List batches","request":{"method":"GET","header":[{"key":"x-godarai-tenant","value":"{{tenant_slug}}"},{"key":"x-godarai-provider-account","value":"{{provider_account_id}}"}],"url":"{{base_url}}/v1beta/batches"}}
    ]},
    {"name":"Google OpenAI Compatibility","item":[
      {"name":"Chat completions","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"x-godarai-tenant","value":"{{tenant_slug}}"}],"body":{"mode":"raw","raw":"{\"model\":\"{{model_fqn_chat}}\",\"messages\":[{\"role\":\"user\",\"content\":\"Compatibility smoke test\"}],\"max_tokens\":32}"},"url":"{{base_url}}/v1/chat/completions"}},
      {"name":"Embeddings","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"x-godarai-tenant","value":"{{tenant_slug}}"}],"body":{"mode":"raw","raw":"{\"model\":\"{{model_fqn_embedding}}\",\"input\":\"Compatibility embedding\",\"dimensions\":768}"},"url":"{{base_url}}/v1/embeddings"}},
      {"name":"Image generations","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"x-godarai-tenant","value":"{{tenant_slug}}"}],"body":{"mode":"raw","raw":"{\"model\":\"{{model_fqn_image}}\",\"prompt\":\"A blue circle on white\",\"n\":1}"},"url":"{{base_url}}/v1/images/generations"}}
    ]}
  ]
}
