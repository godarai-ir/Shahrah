generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProviderStatus {
  active
  preview
  deprecated
  unavailable
}

enum ModelStatus {
  active
  preview
  deprecated
  unavailable
}

enum LifecycleStatus {
  draft
  review
  published
  deprecated
  archived
}

enum ModelPricingStatus {
  unknown
  priced
  free
}

enum PricingUsage {
  input
  output
  cache_read
  cache_write
}

enum PricingServiceTier {
  standard
  batch
  priority
}

model Provider {
  id                      String         @id @default(cuid())
  slug                    String         @unique
  name                    String
  description             String?
  websiteUrl              String?
  docsUrl                 String?
  logoUrl                 String?
  status                  ProviderStatus @default(active)
  enabled                 Boolean        @default(true)
  privacyPolicyUrl        String?
  loggingPolicySummary    String?
  supportsByok            Boolean        @default(false)
  supportsRegionalRouting Boolean        @default(false)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  models                  Model[]
  logoAssets              ProviderLogoAsset[]
  // Legacy value-bearing records are retained only for the redacted migration
  // audit. They are never selected by an API.
  legacyConnectionProfile ProviderConnectionProfile?
  connectionSchemas       ProviderConnectionSchema[]

  @@index([slug])
}

model Model {
  id               String             @id @default(cuid())
  providerId       String
  canonicalId      String             @unique
  slug             String
  displayName      String
  mode             String[]           @default(["unknown"])
  shortDescription String?
  longDescription  String?
  status           ModelStatus        @default(active)
  enabled          Boolean            @default(true)
  lifecycleStatus  LifecycleStatus    @default(draft)
  categoryId       String?
  modelSeriesId    String?
  contextWindow    Int?
  maxOutputTokens  Int?
  knowledgeCutoff  DateTime?
  releaseDate      DateTime?
  deprecatedAt     DateTime?
  openSource       Boolean            @default(false)
  pricingStatus    ModelPricingStatus @default(unknown)
  tokenizer        String?
  license          String?
  huggingFaceUrl   String?
  modelCardUrl     String?
  officialDocsUrl  String?
  popularityScore  Float              @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  provider         Provider                  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category         Category?                 @relation(fields: [categoryId], references: [id])
  modelSeries      ModelSeries?              @relation(fields: [modelSeriesId], references: [id])
  versions         ModelVersion[]
  pricing          ModelPricing[]
  capabilities     ModelCapability[]
  inputModalities  ModelInputModality[]
  outputModalities ModelOutputModality[]
  supportedParams  ModelSupportedParameter[]
  regions          ModelRegion[]
  benchmarks       ModelBenchmark[]
  sources          SourceReference[]
  changelog        ModelChangelog[]
  tags             ModelTag[]

  @@unique([providerId, slug])
  @@index([providerId])
  @@index([status])
  @@index([enabled])
  @@index([contextWindow])
  @@index([maxOutputTokens])
  @@index([slug])
}

model ModelSeries {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  models    Model[]
}

model ProviderConnectionProfile {
  id           String   @id @default(cuid())
  providerId   String   @unique
  providerType String
  authMode     String?
  configJson   Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model ProviderConnectionSchema {
  id           String   @id @default(cuid())
  providerId   String
  authMode     String
  version      Int
  runtimeReady Boolean  @default(false)
  fieldsJson   Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, authMode, version])
  @@index([providerId, authMode, version])
}

model ProviderLogoAsset {
  id          String   @id @default(cuid())
  providerId  String
  fileName    String   @unique
  contentHash String
  contentType String   @default("image/png")
  width       Int      @default(64)
  height      Int      @default(64)
  sizeBytes   Int
  data        Bytes
  createdAt   DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([contentHash])
}

model ModelVersion {
  id          String      @id @default(cuid())
  modelId     String
  version     String
  releaseDate DateTime?
  notes       String?
  status      ModelStatus @default(active)
  createdAt   DateTime    @default(now())

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model ModelPricing {
  id            String    @id @default(cuid())
  modelId       String
  regionId      String
  currency      String    @default("USD")
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  sourceUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  model  Model              @relation(fields: [modelId], references: [id], onDelete: Cascade)
  region Region             @relation(fields: [regionId], references: [id])
  rates  ModelPricingRate[]

  @@index([modelId, regionId])
  @@index([modelId, effectiveFrom, effectiveTo])
}

model ModelPricingRate {
  id             String             @id @default(cuid())
  modelPricingId String
  rateKey        String
  usage          PricingUsage
  unit           String
  amount         Decimal            @db.Decimal(30, 18)
  quantity       Int
  serviceTier    PricingServiceTier @default(standard)
  resolution     String?
  tierFrom       Int?
  tierTo         Int?
  tierMode       String?
  qualifiers     Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  pricing ModelPricing @relation(fields: [modelPricingId], references: [id], onDelete: Cascade)

  @@unique([modelPricingId, rateKey])
  @@index([usage, unit])
  @@index([resolution])
  @@index([amount])
}

model Capability {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?

  models ModelCapability[]
}

model ModelCapability {
  modelId      String
  capabilityId String

  model      Model      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([modelId, capabilityId])
}

model Modality {
  id   String @id @default(cuid())
  slug String @unique
  name String

  inputModels  ModelInputModality[]
  outputModels ModelOutputModality[]
}

model ModelInputModality {
  modelId    String
  modalityId String

  model    Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  modality Modality @relation(fields: [modalityId], references: [id], onDelete: Cascade)

  @@id([modelId, modalityId])
}

model ModelOutputModality {
  modelId    String
  modalityId String

  model    Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  modality Modality @relation(fields: [modalityId], references: [id], onDelete: Cascade)

  @@id([modelId, modalityId])
}

model SupportedParameter {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?

  models ModelSupportedParameter[]
}

model ModelSupportedParameter {
  modelId              String
  supportedParameterId String

  model              Model              @relation(fields: [modelId], references: [id], onDelete: Cascade)
  supportedParameter SupportedParameter @relation(fields: [supportedParameterId], references: [id], onDelete: Cascade)

  @@id([modelId, supportedParameterId])
}

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?

  models Model[]
}

model Region {
  id   String @id @default(cuid())
  slug String @unique
  name String

  models  ModelRegion[]
  pricing ModelPricing[]
}

model ModelRegion {
  modelId  String
  regionId String

  model  Model  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  region Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([modelId, regionId])
}

model Benchmark {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  maxScore    Float?
  scoreType   String?

  modelScores ModelBenchmark[]
}

model ModelBenchmark {
  id          String    @id @default(cuid())
  modelId     String
  benchmarkId String
  score       Float
  percentile  Float?
  sourceUrl   String?
  evaluatedAt DateTime?
  notes       String?

  model     Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  benchmark Benchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)

  @@index([modelId, benchmarkId])
}

model SourceReference {
  id         String    @id @default(cuid())
  modelId    String
  title      String
  url        String
  sourceType String?
  fetchedAt  DateTime?
  notes      String?

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model ModelChangelog {
  id          String   @id @default(cuid())
  modelId     String
  changeType  String
  title       String
  description String?
  changedAt   DateTime @default(now())
  createdBy   String?

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model Tag {
  id   String @id @default(cuid())
  slug String @unique
  name String

  models ModelTag[]
}

model ModelTag {
  modelId String
  tagId   String

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([modelId, tagId])
}

model AuditLog {
  id               String   @id @default(cuid())
  entityType       String
  entityId         String
  action           String
  beforeJson       Json?
  afterJson        Json?
  actorId          String?
  actorRole        String?
  serviceAccountId String?
  requestId        String?
  createdAt        DateTime @default(now())

  @@index([entityType, entityId])
}

model ServiceAccount {
  id          String                     @id @default(cuid())
  name        String                     @unique
  scopes      String[]
  active      Boolean                    @default(true)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  credentials ServiceAccountCredential[]
}

model ServiceAccountCredential {
  id               String         @id
  serviceAccountId String
  secretHash       String
  expiresAt        DateTime?
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime       @default(now())
  serviceAccount   ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)

  @@index([serviceAccountId])
  @@index([expiresAt])
}

model ImportSourceState {
  id             String    @id @default(cuid())
  sourceKey      String    @unique
  repoUrl        String
  ref            String
  lastCommitSha  String?
  lastImportedAt DateTime?
  lastCheckedAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([repoUrl, ref])
}

model DisplaySetting {
  id           String   @id @default("default")
  currencyUnit String   @default("USD")
  dateCalendar String   @default("GREGORIAN")
  priceScale   String   @default("PER_MILLION_TOKENS")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
