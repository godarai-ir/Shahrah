generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProviderStatus {
  active
  preview
  deprecated
  unavailable
}

enum ModelStatus {
  active
  preview
  deprecated
  unavailable
}

enum LifecycleStatus {
  draft
  review
  published
  deprecated
  archived
}

model Provider {
  id                      String   @id @default(cuid())
  slug                    String   @unique
  name                    String
  description             String?
  websiteUrl              String?
  docsUrl                 String?
  logoUrl                 String?
  status                  ProviderStatus @default(active)
  enabled                 Boolean  @default(true)
  privacyPolicyUrl        String?
  loggingPolicySummary    String?
  supportsByok            Boolean  @default(false)
  supportsRegionalRouting Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  models                  Model[]
  connectionProfile       ProviderConnectionProfile?

  @@index([slug])
}

model Model {
  id               String   @id @default(cuid())
  providerId       String
  canonicalId      String   @unique
  slug             String
  displayName      String
  mode             String[] @default(["unknown"])
  shortDescription String?
  longDescription  String?
  status           ModelStatus @default(active)
  enabled          Boolean @default(true)
  lifecycleStatus  LifecycleStatus @default(draft)
  categoryId       String?
  modelSeriesId    String?
  contextWindow    Int?
  maxOutputTokens  Int?
  knowledgeCutoff  DateTime?
  releaseDate      DateTime?
  deprecatedAt     DateTime?
  openSource       Boolean @default(false)
  free             Boolean @default(false)
  tokenizer        String?
  license          String?
  huggingFaceUrl   String?
  modelCardUrl     String?
  officialDocsUrl  String?
  popularityScore  Float   @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  provider         Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category         Category? @relation(fields: [categoryId], references: [id])
  modelSeries      ModelSeries? @relation(fields: [modelSeriesId], references: [id])
  versions         ModelVersion[]
  pricing          ModelPricing[]
  capabilities     ModelCapability[]
  inputModalities  ModelInputModality[]
  outputModalities ModelOutputModality[]
  supportedParams  ModelSupportedParameter[]
  regions          ModelRegion[]
  benchmarks       ModelBenchmark[]
  sources          SourceReference[]
  changelog        ModelChangelog[]
  tags             ModelTag[]

  @@unique([providerId, slug])
  @@index([providerId])
  @@index([status])
  @@index([enabled])
  @@index([contextWindow])
  @@index([maxOutputTokens])
  @@index([slug])
}

model ModelSeries {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  models    Model[]
}

model ProviderConnectionProfile {
  id           String   @id @default(cuid())
  providerId   String   @unique
  providerType String
  authMode     String?
  configJson   Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider     Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model ModelVersion {
  id          String   @id @default(cuid())
  modelId      String
  version     String
  releaseDate DateTime?
  notes       String?
  status      ModelStatus @default(active)
  createdAt   DateTime @default(now())

  model       Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model ModelPricing {
  id                              String   @id @default(cuid())
  modelId                          String
  regionId                         String?
  currency                         String   @default("USD")
  inputPricePerMillionTokens       Float?
  outputPricePerMillionTokens      Float?
  cachedInputPricePerMillionTokens Float?
  imageInputPrice                  Float?
  imageOutputPrice                 Float?
  audioInputPrice                  Float?
  audioOutputPrice                 Float?
  requestPrice                     Float?
  effectiveFrom                    DateTime?
  effectiveTo                      DateTime?
  sourceUrl                        String?
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  model                            Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
  region                           Region? @relation(fields: [regionId], references: [id])

  @@index([modelId])
  @@index([effectiveFrom, effectiveTo])
}

model Capability {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?

  models      ModelCapability[]
}

model ModelCapability {
  modelId      String
  capabilityId String

  model        Model      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([modelId, capabilityId])
}

model Modality {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String

  inputModels   ModelInputModality[]
  outputModels  ModelOutputModality[]
}

model ModelInputModality {
  modelId    String
  modalityId String

  model      Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  modality   Modality @relation(fields: [modalityId], references: [id], onDelete: Cascade)

  @@id([modelId, modalityId])
}

model ModelOutputModality {
  modelId    String
  modalityId String

  model      Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  modality   Modality @relation(fields: [modalityId], references: [id], onDelete: Cascade)

  @@id([modelId, modalityId])
}

model SupportedParameter {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?

  models      ModelSupportedParameter[]
}

model ModelSupportedParameter {
  modelId               String
  supportedParameterId  String

  model                 Model              @relation(fields: [modelId], references: [id], onDelete: Cascade)
  supportedParameter    SupportedParameter @relation(fields: [supportedParameterId], references: [id], onDelete: Cascade)

  @@id([modelId, supportedParameterId])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?

  models      Model[]
}

model Region {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String

  models      ModelRegion[]
  pricing     ModelPricing[]
}

model ModelRegion {
  modelId     String
  regionId    String

  model       Model  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  region      Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([modelId, regionId])
}

model Benchmark {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  maxScore    Float?
  scoreType   String?

  modelScores ModelBenchmark[]
}

model ModelBenchmark {
  id          String   @id @default(cuid())
  modelId      String
  benchmarkId  String
  score       Float
  percentile  Float?
  sourceUrl   String?
  evaluatedAt DateTime?
  notes       String?

  model       Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  benchmark   Benchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)

  @@index([modelId, benchmarkId])
}

model SourceReference {
  id          String   @id @default(cuid())
  modelId      String
  title       String
  url         String
  sourceType  String?
  fetchedAt   DateTime?
  notes       String?

  model       Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model ModelChangelog {
  id          String   @id @default(cuid())
  modelId      String
  changeType  String
  title       String
  description String?
  changedAt   DateTime @default(now())
  createdBy   String?

  model       Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model Tag {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String

  models      ModelTag[]
}

model ModelTag {
  modelId      String
  tagId        String

  model        Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
  tag          Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([modelId, tagId])
}

model AuditLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  action      String
  beforeJson  Json?
  afterJson   Json?
  actorId     String?
  actorRole   String?
  serviceAccountId String?
  requestId   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}

model ServiceAccount {
  id          String   @id @default(cuid())
  name        String   @unique
  scopes      String[]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  credentials ServiceAccountCredential[]
}

model ServiceAccountCredential {
  id               String   @id
  serviceAccountId String
  secretHash       String
  expiresAt        DateTime?
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime @default(now())
  serviceAccount   ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)

  @@index([serviceAccountId])
  @@index([expiresAt])
}

model DisplaySetting {
  id            String   @id @default("default")
  currencyUnit  String   @default("USD")
  dateCalendar  String   @default("GREGORIAN")
  priceScale    String   @default("PER_MILLION_TOKENS")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
