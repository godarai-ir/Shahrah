{
    "name": "model-discovery",
    "version": "0.0.1",
    "packageManager": "pnpm@10.0.0",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"src/**/*.ts\" --fix --ignore-pattern src/generated/**",
        "typecheck": "tsc -p tsconfig.test.json",
        "test": "jest --passWithNoTests",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "prisma:generate": "prisma generate",
        "prisma:migrate:dev": "prisma migrate dev",
        "prisma:studio": "prisma studio",
        "prisma:seed": "tsx prisma/seed.ts",
        "service-account:create": "tsx scripts/create-service-account.ts",
        "service-account:revoke": "tsx scripts/revoke-service-account-key.ts",
        "import:provider:anthropic": "tsx scripts/import-anthropic-from-yaml.ts",
        "import:provider:google-gemini": "tsx scripts/import-google-gemini-from-yaml.ts",
        "import:provider:openai": "tsx scripts/import-openai-from-yaml.ts",
        "import:providers:yaml": "tsx scripts/import-models-from-yaml.ts",
        "openapi:export": "node -r ts-node/register -r tsconfig-paths/register scripts/export-openapi.ts",
        "audit:provider-connection-secrets": "tsx scripts/audit-provider-connection-secrets.ts"
    },
    "dependencies": {
        "@nestjs/bullmq": "^11.0.4",
        "@nestjs/common": "^11.1.26",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.1.26",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.26",
        "@nestjs/swagger": "^11.4.4",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@prisma/client-runtime-utils": "^7.8.0",
        "bcrypt": "^6.0.0",
        "bullmq": "^5.78.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "ioredis": "^5.11.1",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.21.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "sharp": "^0.35.3",
        "swagger-ui-express": "^5.0.1",
        "typesense": "3.0.6",
        "yaml": "^2.9.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^9.39.4",
        "@nestjs/cli": "^11.0.23",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.1.26",
        "@swc/core": "^1.15.47",
        "@swc/jest": "^0.2.39",
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.13.2",
        "@types/passport-jwt": "^4.0.1",
        "@types/supertest": "^7.2.0",
        "dotenv": "17.4.2",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.6.0",
        "jest": "^30.4.2",
        "prettier": "^3.8.4",
        "prisma": "^7.8.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.2.2",
        "ts-loader": "^9.6.0",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.22.4",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.61.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "@swc/jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    }
}
