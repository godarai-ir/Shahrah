---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import CategoryPill from "../components/CategoryPill.astro";
import NewsletterCard from "../components/NewsletterCard.astro";
import PostCard from "../components/PostCard.astro";
import {
  getCategoryUrl,
  groupPostsByCategory,
  groupPostsByTag,
  isPublished,
  sortPosts,
} from "../utils/blog";

const posts = sortPosts(await getCollection("blog", isPublished));
const featured = posts.filter((post) => post.data.featured).slice(0, 3);
const latest = posts.slice(0, 6);
const categories = groupPostsByCategory(posts);
const tags = groupPostsByTag(posts).slice(0, 8);
const canonical = (Astro.site || new URL("https://godarai.ir/blog")).toString();
---

<Layout
  title="Shahrah Blog | بلاگ فارسی برای آموزش فنی و محتوای تکنیکال"
  description="بلاگ Shahrah با تمرکز بر مقاله‌های آموزشی فارسی، محتوای فنی، تجربه محصول، SEO مدرن و ساختار مناسب برای رشد ارگانیک."
  canonical={canonical}
>
  <section class="section-shell pt-8 pb-16 lg:pt-12 lg:pb-24">
    <section class="hero-panel px-6 py-8 lg:px-10 lg:py-12">
      <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.35em] text-brand-700">Persian Technical Editorial</p>
          <h1 class="mt-5 max-w-4xl text-4xl font-black leading-[1.35] text-slate-950 md:text-6xl">
            طراحی‌شده برای مقاله‌های فنی فارسی که هم خواندنی باشند و هم برای SEO رشد کنند
          </h1>
          <p class="mt-6 max-w-3xl text-base leading-8 text-slate-600 lg:text-lg">
            این قالب برای بلاگ‌های آموزشی و تکنیکال بازطراحی شده: تایپوگرافی خوانا، راست‌به‌چپ استاندارد، ساختار
            semantic، بلوک‌های مناسب آموزش، و مسیر محتوایی روشن برای افزایش دیده‌شدن در موتورهای جست‌وجو.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              class="inline-flex items-center justify-center rounded-full bg-brand-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-brand-700"
              href="/blog"
            >
              مشاهده آرشیو مقاله‌ها
            </a>
            <a
              class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-6 py-3 text-sm font-bold text-slate-700 transition hover:border-brand-200 hover:text-brand-700"
              href="/blog/search"
            >
              جست‌وجو در محتوا
            </a>
          </div>
        </div>

        <div class="content-panel p-6 lg:p-7">
          <h2 class="text-lg font-black text-slate-950">فوکوس‌های طراحی جدید</h2>
          <ul class="mt-5 space-y-4 text-sm leading-7 text-slate-600">
            <li>صفحه مقاله بهینه‌شده برای اسکن سریع، مطالعه عمیق و مرور سرفصل‌ها</li>
            <li>ساختار آماده برای meta tags، Article schema، Breadcrumb schema و FAQ schema</li>
            <li>کارت‌های محتوایی حرفه‌ای برای آموزش، تحلیل، کد، جدول و callout</li>
            <li>چیدمان mobile-first با حفظ کیفیت تجربه مطالعه روی دسکتاپ</li>
          </ul>
        </div>
      </div>
    </section>

    {featured.length > 0 && (
      <section class="mt-10">
        <div class="mb-5 flex items-center justify-between gap-4">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.25em] text-brand-700">Featured</p>
            <h2 class="mt-2 text-2xl font-black text-slate-950">مقاله‌های شاخص</h2>
          </div>
          <a class="text-sm font-bold text-brand-700 transition hover:text-slate-950" href="/blog">
            آرشیو کامل
          </a>
        </div>
        <div class="grid gap-6 lg:grid-cols-3">
          {featured.map((post, index) => (
            <PostCard post={post} featured={index === 0} />
          ))}
        </div>
      </section>
    )}

    <section class="mt-12 grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
      <div>
        <div class="mb-5 flex items-center justify-between gap-4">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.25em] text-brand-700">Latest Articles</p>
            <h2 class="mt-2 text-2xl font-black text-slate-950">جدیدترین مقاله‌ها</h2>
          </div>
          <a class="text-sm font-bold text-brand-700 transition hover:text-slate-950" href="/blog">
            مشاهده همه
          </a>
        </div>
        <div class="grid gap-6">
          {latest.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </div>

      <div class="space-y-8">
        <section class="content-panel p-6">
          <div class="flex items-center justify-between gap-4">
            <h2 class="text-xl font-black text-slate-950">دسته‌بندی‌ها</h2>
            <span class="text-sm text-slate-500">{categories.length.toLocaleString("fa-IR")} دسته</span>
          </div>
          <div class="mt-5 flex flex-wrap gap-3">
            {categories.map((item) => (
              <CategoryPill href={getCategoryUrl(item.category)} label={item.category} count={item.posts.length} />
            ))}
          </div>
        </section>

        <section class="content-panel p-6">
          <div class="flex items-center justify-between gap-4">
            <h2 class="text-xl font-black text-slate-950">برچسب‌های پرتکرار</h2>
            <span class="text-sm text-slate-500">برای internal linking بهتر</span>
          </div>
          <div class="mt-5 flex flex-wrap gap-3">
            {tags.map((item) => (
              <CategoryPill href={`/blog/tag/${item.slug}`} label={`#${item.tag}`} count={item.posts.length} />
            ))}
          </div>
        </section>

        <NewsletterCard compact />
      </div>
    </section>
  </section>
</Layout>
