---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { formatPersianDate, getPostCategory, getPostUrl, isPublished, sortPosts } from "../utils/blog";

const posts = sortPosts(await getCollection("blog", isPublished));
const canonical = new URL("/blog/search", Astro.site || new URL("https://godarai.ir/blog")).toString();
const searchablePosts = posts.map((post) => ({
  title: post.data.title,
  description: post.data.excerpt || post.data.description,
  category: getPostCategory(post),
  tags: post.data.tags,
  url: getPostUrl(post),
  date: formatPersianDate(post.data.pubDate),
}));
---

<Layout
  title="جست‌وجو در بلاگ گدارAI"
  description="جست‌وجوی داخلی در مقاله‌های فنی و آموزشی بلاگ گدارAI."
  canonical={canonical}
>
  <section class="section-shell pt-8 pb-16 lg:pt-12 lg:pb-24">
    <section class="hero-panel px-6 py-8 lg:px-10 lg:py-10">
      <p class="text-sm font-bold uppercase tracking-[0.3em] text-brand-700">Search</p>
      <h1 class="mt-4 text-4xl font-black leading-[1.35] text-slate-950 md:text-5xl">جست‌وجو در مقاله‌ها</h1>
      <p class="mt-4 max-w-3xl text-base leading-8 text-slate-600">
        این صفحه برای کشف سریع محتوا، بهبود UX مرور بلاگ و دسترسی بهتر به مقاله‌های فنی طراحی شده است.
      </p>
      <div class="mt-8">
        <label class="sr-only" for="blog-search-input">عبارت جست‌وجو</label>
        <input
          id="blog-search-input"
          type="search"
          placeholder="مثلاً: LLM Gateway، Prompt Management، AI Infrastructure"
          class="min-h-14 w-full rounded-[1.5rem] border border-slate-200 bg-white px-5 text-base text-slate-900 shadow-soft focus:border-brand-300 focus:outline-none"
        />
      </div>
    </section>

    <section class="mt-8">
      <div class="mb-5 flex items-center justify-between gap-4">
        <h2 class="text-xl font-black text-slate-950">نتیجه‌ها</h2>
        <p id="results-count" class="text-sm text-slate-500">{posts.length.toLocaleString("fa-IR")} مقاله</p>
      </div>

      <div id="search-results" class="grid gap-6">
        {searchablePosts.map((post) => (
          <article
            class="content-panel p-6"
            data-searchable={`${post.title} ${post.description} ${post.category} ${post.tags.join(" ")}`.toLowerCase()}
          >
            <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500">
              <span class="badge-pill badge-brand">{post.category}</span>
              <span>{post.date}</span>
            </div>
            <h3 class="mt-4 text-2xl font-black leading-[1.5] text-slate-950">
              <a class="transition hover:text-brand-700" href={post.url}>{post.title}</a>
            </h3>
            <p class="mt-3 text-sm leading-7 text-slate-600">{post.description}</p>
          </article>
        ))}
      </div>
    </section>
  </section>

  <script is:inline define:vars={{ totalPosts: posts.length }}>
    const input = document.querySelector("#blog-search-input");
    const count = document.querySelector("#results-count");
    const cards = Array.from(document.querySelectorAll("[data-searchable]"));

    const updateResults = () => {
      const query = String(input?.value || "").trim().toLowerCase();
      let visible = 0;

      for (const card of cards) {
        const haystack = card.getAttribute("data-searchable") || "";
        const matches = query.length === 0 || haystack.includes(query);
        card.toggleAttribute("hidden", !matches);
        if (matches) visible += 1;
      }

      if (count) {
        count.textContent = `${visible.toLocaleString("fa-IR")} مقاله از ${totalPosts.toLocaleString("fa-IR")}`;
      }
    };

    input?.addEventListener("input", updateResults);
  </script>
</Layout>
