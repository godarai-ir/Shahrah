---
import { getCollection } from "astro:content";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CategoryPill from "../../../components/CategoryPill.astro";
import Layout from "../../../layouts/Layout.astro";
import NewsletterCard from "../../../components/NewsletterCard.astro";
import PostCard from "../../../components/PostCard.astro";
import type { BlogPost } from "../../../utils/blog";
import {
  getCategoryLabelFromSlug,
  getCategorySlug,
  getCategoryUrl,
  getPostCategory,
  groupPostsByCategory,
  isPublished,
  sortPosts,
} from "../../../utils/blog";

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection("blog", isPublished));
  const categories = groupPostsByCategory(posts);

  return categories.map((item) => ({
    params: { category: item.slug },
    props: { posts, categorySlug: item.slug },
  }));
}

const { posts, categorySlug } = Astro.props as {
  posts: BlogPost[];
  categorySlug: string;
};
const categories = groupPostsByCategory(posts);
const categoryLabel = getCategoryLabelFromSlug(posts, categorySlug);
const categoryPosts = posts.filter(
  (post) => getCategorySlug(getPostCategory(post)) === categorySlug,
);
const site = Astro.site || new URL("https://godarai.ir/blog");
const canonical = new URL(getCategoryUrl(categoryLabel), site).toString();
---

<Layout
  title={`${categoryLabel} | دسته‌بندی بلاگ Shahrah`}
  description={`آرشیو مقاله‌های دسته ${categoryLabel} در بلاگ Shahrah.`}
  canonical={canonical}
>
  <section class="section-shell pt-8 pb-16 lg:pt-12 lg:pb-24">
    <section class="hero-panel px-6 py-8 lg:px-10 lg:py-10">
      <Breadcrumbs
        items={[
          { label: "خانه", href: "/" },
          { label: "بلاگ", href: "/blog" },
          { label: categoryLabel },
        ]}
      />
      <h1 class="mt-5 text-4xl font-black leading-[1.35] text-slate-950 md:text-5xl">{categoryLabel}</h1>
      <p class="mt-4 max-w-3xl text-base leading-8 text-slate-600">
        {categoryPosts.length.toLocaleString("fa-IR")} مقاله در این دسته منتشر شده و همگی با تمرکز بر محتوای آموزشی،
        ساختار فنی و خوانایی فارسی قابل مرور هستند.
      </p>
    </section>

    <section class="mt-8 grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
      <aside class="space-y-6">
        <section class="content-panel p-6">
          <h2 class="text-lg font-black text-slate-950">همه دسته‌ها</h2>
          <div class="mt-5 flex flex-wrap gap-3">
            {categories.map((item) => (
              <CategoryPill
                href={getCategoryUrl(item.category)}
                label={item.category}
                count={item.posts.length}
                active={item.slug === categorySlug}
              />
            ))}
          </div>
        </section>
        <NewsletterCard compact />
      </aside>

      <section class="grid gap-6">
        {categoryPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </section>
    </section>
  </section>
</Layout>
