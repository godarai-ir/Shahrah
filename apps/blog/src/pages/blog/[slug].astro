---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import type { BlogPost } from "../../utils/blog";
import {
  getCategoryUrl,
  getPostCategory,
  getPostSlug,
  getPostUrl,
  isPublished,
} from "../../utils/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog", isPublished);

  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props as { post: BlogPost };
const { Content } = await render(post);
const site = Astro.site || new URL("https://shahrah.ir/blog");
const canonical = post.data.canonicalUrl || new URL(getPostUrl(post), site).toString();
const title = post.data.seoTitle || post.data.title;
const description = post.data.excerpt || post.data.description;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
  inLanguage: "fa-IR",
  mainEntityOfPage: canonical,
  articleSection: getPostCategory(post),
  keywords: post.data.tags.join(", "),
  publisher: {
    "@type": "Organization",
    name: "Shahrah",
  },
};
---

<Layout title={title} description={description} canonical={canonical} image={post.data.heroImage}>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
    {post.data.updatedDate && (
      <meta property="article:modified_time" content={post.data.updatedDate.toISOString()} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>

  <main class="shell">
    <article class="article">
      <header class="header">
        <p class="breadcrumbs">
          <a href="/blog">بلاگ</a>
          <span>/</span>
          <a href={getCategoryUrl(getPostCategory(post))}>{getPostCategory(post)}</a>
        </p>
        <h1>{post.data.title}</h1>
        <p class="lede">{description}</p>
        <div class="meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString("fa-IR")}
          </time>
          {post.data.updatedDate && (
            <span>آخرین به‌روزرسانی: {post.data.updatedDate.toLocaleDateString("fa-IR")}</span>
          )}
        </div>
        {post.data.tags.length > 0 && <p class="tags">{post.data.tags.join(" / ")}</p>}
      </header>

      <section class="content">
        <Content />
      </section>
    </article>
  </main>
</Layout>

<style>
  .shell {
    margin: 0 auto;
    max-width: 880px;
    padding: 3rem 1.25rem 5rem;
  }

  .article {
    background: var(--surface-strong);
    border: 1px solid var(--border);
    border-radius: 32px;
    box-shadow: var(--shadow);
    padding: 2.2rem;
  }

  .breadcrumbs,
  .meta,
  .lede,
  .tags {
    color: var(--muted);
  }

  .breadcrumbs {
    display: flex;
    gap: 0.45rem;
    margin-top: 0;
  }

  .breadcrumbs a {
    text-decoration: none;
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.15;
    margin: 0.75rem 0 1rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .content :global(h2),
  .content :global(h3) {
    margin-top: 2.2rem;
  }

  .content :global(p),
  .content :global(li) {
    font-size: 1.06rem;
  }
</style>
