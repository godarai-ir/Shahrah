---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import {
  getCategoryUrl,
  getPostCategory,
  getPostUrl,
  groupPostsByCategory,
  isPublished,
  sortPosts,
} from "../../utils/blog";

const posts = sortPosts(await getCollection("blog", isPublished));
const categories = groupPostsByCategory(posts);
const site = Astro.site || new URL("https://shahrah.ir/blog");
const canonical = new URL("/blog", site).toString();
---

<Layout
  title="آرشیو بلاگ Shahrah | مقالات فنی و تحلیلی"
  description="آرشیو همه مقاله‌های Shahrah به تفکیک موضوع، مناسب برای رشد محتوای محصول، سئو و انتشار منظم مقالات Markdown."
  canonical={canonical}
>
  <main class="shell">
    <section class="hero">
      <p class="eyebrow">Shahrah Editorial Hub</p>
      <h1>آرشیو مقاله‌ها</h1>
      <p class="body">
        همه مقاله‌های Markdown اینجا به‌صورت ساختاریافته منتشر می‌شوند؛ با دسته‌بندی
        شفاف، مسیرهای تمیز و متادیتای آماده برای SEO.
      </p>
    </section>

    <section class="categories">
      {categories.map((item) => (
        <a class="chip" href={getCategoryUrl(item.category)}>
          <span>{item.category}</span>
          <strong>{item.posts.length}</strong>
        </a>
      ))}
    </section>

    <section class="grid">
      {posts.map((post) => (
        <article class="card">
          <p class="meta">
            <a href={getCategoryUrl(getPostCategory(post))}>{getPostCategory(post)}</a>
            <span>•</span>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString("fa-IR")}
            </time>
          </p>
          <h2>
            <a href={getPostUrl(post)}>{post.data.title}</a>
          </h2>
          <p>{post.data.excerpt || post.data.description}</p>
          {post.data.tags.length > 0 && <p class="tags">{post.data.tags.join(" / ")}</p>}
        </article>
      ))}
    </section>
  </main>
</Layout>

<style>
  .shell {
    margin: 0 auto;
    max-width: 1100px;
    padding: 3rem 1.25rem 5rem;
  }

  .hero {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 32px;
    box-shadow: var(--shadow);
    padding: 2.5rem;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.4rem, 6vw, 4.8rem);
    line-height: 1;
    margin: 0.75rem 0 1rem;
  }

  .body,
  .card p {
    color: var(--muted);
  }

  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0 2rem;
  }

  .chip {
    align-items: center;
    background: var(--accent-soft);
    border-radius: 999px;
    display: inline-flex;
    gap: 0.6rem;
    padding: 0.8rem 1rem;
    text-decoration: none;
  }

  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .card {
    background: var(--surface-strong);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 1.4rem;
  }

  .meta {
    align-items: center;
    display: flex;
    gap: 0.45rem;
    font-size: 0.92rem;
    margin: 0 0 0.8rem;
  }

  .meta a,
  h2 a {
    text-decoration: none;
  }

  h2 {
    font-size: 1.35rem;
    line-height: 1.35;
    margin: 0;
  }

  .tags {
    font-size: 0.9rem;
    margin-bottom: 0;
  }
</style>
