---
import { getCollection } from "astro:content";
import CategoryPill from "../../components/CategoryPill.astro";
import NewsletterCard from "../../components/NewsletterCard.astro";
import PaginationNav from "../../components/PaginationNav.astro";
import PostCard from "../../components/PostCard.astro";
import Layout from "../../layouts/Layout.astro";
import {
  getArchivePageUrl,
  getCategoryUrl,
  groupPostsByCategory,
  groupPostsByTag,
  isPublished,
  paginatePosts,
  sortPosts,
} from "../../utils/blog";

const posts = sortPosts(await getCollection("blog", isPublished));
const categories = groupPostsByCategory(posts);
const tags = groupPostsByTag(posts).slice(0, 12);
const pagination = paginatePosts(posts, 1, 6);
const site = Astro.site || new URL("https://godarai.ir/blog");
const canonical = new URL("/blog", site).toString();
---

<Layout
  title="آرشیو بلاگ Shahrah | مقالات فنی و تحلیلی"
  description="آرشیو مقالات فنی و آموزشی Shahrah با ساختار مناسب برای محتوای فارسی، دسته‌بندی، برچسب‌گذاری، جست‌وجو و سئوی مدرن."
  canonical={canonical}
>
  <section class="section-shell pt-8 pb-16 lg:pt-12 lg:pb-24">
    <section class="hero-panel px-6 py-8 lg:px-10 lg:py-10">
      <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.3em] text-brand-700">Archive</p>
          <h1 class="mt-4 text-4xl font-black leading-[1.35] text-slate-950 md:text-5xl">آرشیو مقاله‌های فنی و آموزشی</h1>
          <p class="mt-5 max-w-3xl text-base leading-8 text-slate-600">
            همه مقاله‌ها به‌صورت ساختاریافته و قابل کشف در یک آرشیو فارسی جمع شده‌اند؛ با محوریت خوانایی، SEO،
            internal linking و تجربه مرور سریع محتوا.
          </p>
        </div>
        <div class="content-panel p-6">
          <div class="grid grid-cols-3 gap-4 text-center">
            <div>
              <div class="text-2xl font-black text-slate-950">{posts.length.toLocaleString("fa-IR")}</div>
              <div class="mt-1 text-xs text-slate-500">مقاله</div>
            </div>
            <div>
              <div class="text-2xl font-black text-slate-950">{categories.length.toLocaleString("fa-IR")}</div>
              <div class="mt-1 text-xs text-slate-500">دسته</div>
            </div>
            <div>
              <div class="text-2xl font-black text-slate-950">{tags.length.toLocaleString("fa-IR")}</div>
              <div class="mt-1 text-xs text-slate-500">برچسب شاخص</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-8 grid gap-8 lg:grid-cols-[0.78fr_1.22fr]">
      <aside class="space-y-6">
        <section class="content-panel p-6">
          <h2 class="text-lg font-black text-slate-950">دسته‌بندی‌ها</h2>
          <div class="mt-5 flex flex-wrap gap-3">
            {categories.map((item) => (
              <CategoryPill href={getCategoryUrl(item.category)} label={item.category} count={item.posts.length} />
            ))}
          </div>
        </section>

        <section class="content-panel p-6">
          <h2 class="text-lg font-black text-slate-950">برچسب‌ها</h2>
          <div class="mt-5 flex flex-wrap gap-3">
            {tags.map((item) => (
              <CategoryPill href={`/blog/tag/${item.slug}`} label={`#${item.tag}`} count={item.posts.length} />
            ))}
          </div>
        </section>

        <NewsletterCard compact />
      </aside>

      <div class="space-y-6">
        {pagination.items.map((post) => (
          <PostCard post={post} />
        ))}

        <PaginationNav currentPage={pagination.currentPage} totalPages={pagination.totalPages} />

        {pagination.totalPages > 1 && (
          <div class="text-center text-sm text-slate-500">
            برای ادامه آرشیو به صفحه‌های بعدی بروید:
            <a class="mr-2 font-bold text-brand-700" href={getArchivePageUrl(2)}>صفحه ۲</a>
          </div>
        )}
      </div>
    </section>
  </section>
</Layout>
