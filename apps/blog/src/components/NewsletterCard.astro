---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props as Props;
---

<section class:list={[
  "relative overflow-hidden rounded-[2rem] border border-brand-200 bg-slate-950 text-white shadow-card",
  compact ? "p-6" : "p-8 lg:p-10",
]}>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(45,212,191,0.32),transparent_36%),radial-gradient(circle_at_bottom_right,rgba(251,191,36,0.24),transparent_32%)]"></div>
  <div class="relative">
    <p class="text-sm font-semibold uppercase tracking-[0.28em] text-brand-200">Newsletter</p>
    <h2 class="mt-4 text-2xl font-black leading-[1.5] text-balance lg:text-3xl">
      خلاصه آموزش‌ها و مقاله‌های فنی جدید را منظم دریافت کنید
    </h2>
    <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-300">
      ماهی چند یادداشت کوتاه درباره درگاه مدل‌های زبانی، کنترل هزینه، مشاهده‌پذیری و تجربه‌های عملی تیم‌های
      محصول برایتان می‌فرستیم.
    </p>
    <form class="mt-6 flex flex-col gap-3 sm:flex-row" action="#" method="post">
      <label class="sr-only" for="newsletter-email">ایمیل</label>
      <input
        id="newsletter-email"
        name="email"
        type="email"
        inputmode="email"
        placeholder="ایمیل کاری شما"
        class="min-h-12 flex-1 rounded-full border border-white/15 bg-white/10 px-5 text-sm text-white placeholder:text-slate-400 focus:border-brand-300 focus:bg-white/15 focus:outline-none"
      />
      <button
        type="submit"
        class="min-h-12 rounded-full bg-white px-6 text-sm font-bold text-slate-950 transition hover:bg-brand-100"
      >
        عضویت در خبرنامه
      </button>
    </form>
  </div>
</section>
