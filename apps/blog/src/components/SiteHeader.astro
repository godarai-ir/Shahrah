---
import GodarAILogo from "./GodarAILogo.astro";

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class="sticky top-0 z-40 border-b border-white/70 bg-white/85 backdrop-blur-xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-4 sm:px-6 lg:px-8">
    <a href={basePath || "/"} class="flex items-center gap-3 text-right">
      <span class="flex size-11 items-center justify-center rounded-2xl bg-white p-1 shadow-soft ring-1 ring-slate-200">
        <GodarAILogo
          decorative
          variant="light"
          class="theme-logo-light h-full w-auto max-w-full object-contain"
        />
        <GodarAILogo
          decorative
          variant="dark"
          class="theme-logo-dark h-full w-auto max-w-full object-contain"
        />
      </span>
      <span>
        <span class="block text-sm font-semibold text-brand-700">بلاگ گدارAI</span>
        <span class="hidden text-xs text-slate-500 sm:block">بلاگ فنی، آموزشی و تحلیلی</span>
      </span>
    </a>

    <nav aria-label="ناوبری اصلی" class="hidden items-center gap-2 md:flex">
      <a class="nav-link" href={basePath || "/"}>خانه</a>
      <a class="nav-link" href="/blog">آرشیو مقاله‌ها</a>
      <a class="nav-link" href="/blog/search">جست‌وجو</a>
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        aria-label="فعال‌کردن تم تیره"
        title="فعال‌کردن تم تیره"
        aria-pressed="false"
      >
        <svg data-theme-icon="moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
        </svg>
        <svg data-theme-icon="sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
        </svg>
      </button>
      <a
        href="/blog"
        class="inline-flex items-center justify-center rounded-full bg-slate-950 px-3 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 sm:px-5"
      >
        <span class="sm:hidden">مطالعه</span>
        <span class="hidden sm:inline">شروع مطالعه</span>
      </a>
    </div>
  </div>
</header>
