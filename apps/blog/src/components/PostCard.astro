---
import type { BlogPost } from "../utils/blog";
import {
  formatPersianDate,
  getPostCategory,
  getPostUrl,
  getReadingTime,
  getCategoryUrl,
  getTagUrl,
} from "../utils/blog";

interface Props {
  post: BlogPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props as Props;
---

<article class:list={[
  "group relative flex h-full flex-col overflow-hidden rounded-[2rem] border border-slate-200/80 bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:shadow-card",
  featured && "lg:p-8",
]}>
  <div class="absolute inset-x-6 top-0 h-px bg-gradient-to-l from-transparent via-brand-400 to-transparent opacity-70"></div>
  <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500">
    <a class="badge-pill badge-brand" href={getCategoryUrl(getPostCategory(post))}>{getPostCategory(post)}</a>
    <time datetime={post.data.pubDate.toISOString()}>{formatPersianDate(post.data.pubDate)}</time>
    <span aria-hidden="true">•</span>
    <span>{getReadingTime(post)} دقیقه مطالعه</span>
  </div>

  <h2 class:list={["mt-5 text-balance font-black tracking-tight text-slate-950", featured ? "text-3xl leading-[1.35]" : "text-2xl leading-[1.5]"]}>
    <a class="transition hover:text-brand-700" href={getPostUrl(post)}>{post.data.title}</a>
  </h2>

  <p class="mt-4 text-sm leading-7 text-slate-600">{post.data.excerpt || post.data.description}</p>

  {post.data.tags.length > 0 && (
    <div class="mt-5 flex flex-wrap gap-2">
      {post.data.tags.slice(0, featured ? 4 : 3).map((tag) => (
        <a href={getTagUrl(tag)} class="badge-pill badge-muted">#{tag}</a>
      ))}
    </div>
  )}

  <div class="mt-6 flex items-center justify-between border-t border-slate-200 pt-5 text-sm">
    <span class="text-slate-500">{post.data.authorName}</span>
    <a class="font-semibold text-brand-700 transition hover:text-slate-950" href={getPostUrl(post)}>
      مطالعه مقاله
    </a>
  </div>
</article>
