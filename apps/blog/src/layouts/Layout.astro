---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
}

const {
  title = "بلاگ گدارAI | مقالات، تحلیل و آموزش",
  description = "بلاگ گدارAI برای انتشار مقاله‌های فنی، آموزشی و تحلیلی درباره زیرساخت هوش مصنوعی، درگاه مدل‌های زبانی و مدیریت محصول.",
  canonical,
  image,
} = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = Astro.site || new URL("https://godarai.ir/blog");
const socialImage = new URL(
  image || `${basePath}/brand/social/og-image-light-1200x630.png`,
  site,
).toString();
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${basePath}/brand/icons/favicon.svg`} />
    <link rel="icon" href={`${basePath}/brand/icons/favicon-light.ico`} media="(prefers-color-scheme: light)" />
    <link rel="icon" href={`${basePath}/brand/icons/favicon-dark.ico`} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${basePath}/brand/icons/favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${basePath}/brand/icons/apple-touch-icon.png`} sizes="180x180" />
    <link rel="mask-icon" href={`${basePath}/brand/svg/safari-pinned-tab.svg`} color="#00C9EB" />
    <link rel="manifest" href={`${basePath}/brand/web/site.webmanifest`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FFFFFF" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#06182D" />
    <meta name="msapplication-config" content={`${basePath}/brand/web/browserconfig.xml`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:site_name" content="بلاگ گدارAI" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={`لوگوی گدارAI — ${title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={`لوگوی گدارAI — ${title}`} />
    {canonical && <link rel="canonical" href={canonical} />}
    <slot name="head" />
  </head>
  <body class="text-right">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:right-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-slate-950"
    >
      پرش به محتوا
    </a>
    <SiteHeader />
    <div class="relative">
      <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[30rem] bg-[radial-gradient(circle_at_top,rgba(45,212,191,0.12),transparent_42%)]"></div>
      <main id="content">
        <slot />
      </main>
    </div>
    <SiteFooter />
  </body>
</html>
