# Demo stack configuration.
# Run scripts/init-env.sh to copy this file to .env with every __SECRET__
# placeholder replaced by a freshly generated value.

# --- Domain -----------------------------------------------------------------
# Apex domain. Routes: DOMAIN, auth.DOMAIN, admin.DOMAIN, <tenant>.DOMAIN.
DEMO_DOMAIN=godarai.ir

# --- Images -----------------------------------------------------------------
# Tags match shahrah-gitops/helm/shahrah/values.production.yaml.
IMAGE_REGISTRY=docker.io/delpak
CONTROL_PLANE_TAG=v0.68.0
TENANT_ADMIN_TAG=v0.70.0
WEBSITE_TAG=v0.52.0
MODEL_DISCOVERY_TAG=v0.52.0
MODEL_DISCOVERY_WEB_TAG=v0.36.0
SUPPORT_ADMIN_TAG=v0.40.0
SILK_ROAD_TAG=v0.52.0
GOOSE_TAG=v0.29.0
BLOG_TAG=v0.43.0
DOCS_TAG=v0.51.0

# --- Datastore credentials (generated) -------------------------------------
POSTGRES_PASSWORD=__HEX__
SUPPORT_ADMIN_DB_PASSWORD=__HEX__
REDIS_PASSWORD=__HEX__
CLICKHOUSE_PASSWORD=__HEX__
TYPESENSE_API_KEY=__HEX__
PRIVATE_FILES_S3_ACCESS_KEY=demo-files
PRIVATE_FILES_S3_SECRET_KEY=__HEX__

# --- Application secrets (generated) ---------------------------------------
MASTER_KEY=sk-demo-__HEX__
JWT_SECRET=__HEX__
BETTER_AUTH_SECRET=__HEX__
TRACE_PAYLOAD_ENCRYPTION_KEY=__B64_32__
TRACE_PII_HASH_SALT=__HEX__
PLATFORM_PROVIDER_CREDENTIAL_ACTIVE_KEK_VERSION=demo-v1
PLATFORM_PROVIDER_CREDENTIAL_KEKS_JSON='{"demo-v1":"__B64_32__"}'
PLATFORM_PROVIDER_CREDENTIAL_FINGERPRINT_KEY=__B64_32__
TENANT_PROVIDER_CREDENTIAL_ACTIVE_KEK_VERSION=demo-v1
TENANT_PROVIDER_CREDENTIAL_KEKS_JSON='{"demo-v1":"__B64_32__"}'
TENANT_PROVIDER_CREDENTIAL_FINGERPRINT_KEY=__B64_32__

# --- Service tokens (fill after first start, see README) -------------------
SHAHRAH_DISCOVERY_TOKEN=
MODEL_DISCOVERY_SERVICE_TOKEN=
CONTROL_PLANE_SERVICE_TOKEN=

# --- Provider egress ---------------------------------------------------------
# Set when the VPS cannot reach provider APIs directly (for example, hosted in Iran).
SILK_ROAD_EGRESS_PROXY_URL=
SILK_ROAD_EGRESS_PROXY_REQUIRED=false

# --- Optional integrations -------------------------------------------------
OPENAI_API_KEY=
TYPESAFE_API_KEY=
SHAHRAH_SMART_CACHE_EMBEDDING_BASE_URL=
SHAHRAH_SMART_CACHE_EMBEDDING_API_KEY=

EMAIL_SENDING_ENABLED=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@godarai.ir
RESEND_FROM_NAME=Godar-AI
RESEND_REPLY_TO=support@godarai.ir
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=noreply@godarai.ir

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

BALE_OTP_ENABLED=false
BALE_SAFIR_API_ACCESS_KEY=
BALE_SAFIR_BOT_ID=

# --- Support attachments ---------------------------------------------------
# Leave empty to skip malware scanning (saves ~1.2 GB RAM). To scan, start the
# "clamav" profile, set clamav:3310 here, and set ALLOW_UNSCANNED=false.
SUPPORT_CLAMAV_ADDRESS=
SUPPORT_ATTACHMENT_ALLOW_UNSCANNED=true

# --- Backups (scripts/backup.sh) -------------------------------------------
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_LOCAL_RETENTION_DAYS=7
