# Required by the control-plane semantic cache and managed RAG.
# The complete embedding base URL may contain provider credentials; never commit its real value.
SHAHRAH_SMART_CACHE_EMBEDDING_BASE_URL=https://embedding-provider.example/v1
SHAHRAH_SMART_CACHE_EMBEDDING_API_KEY=replace-me

# Exact enabled rerank deployment identifier, preferably provider:account:model.
RAG_GATEWAY_RERANK_MODEL=cohere:account-alias:rerank-multilingual-v3.0
