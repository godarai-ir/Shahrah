[Unit]
Description=Reverse SSH tunnel from node-4-eu Squid to nat-gw-1
Wants=network-online.target
After=network-online.target squid.service
Requires=squid.service

[Service]
Type=simple
User=ubuntu
Environment=HOME=/home/ubuntu
ExecStart=/usr/bin/ssh -N -T -i /home/ubuntu/.ssh/node4_to_nat_proxy -o BatchMode=yes -o StrictHostKeyChecking=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -R 127.0.0.1:1443:127.0.0.1:443 ubuntu@188.121.120.198
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
