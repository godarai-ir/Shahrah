generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Budget {
  budget_id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  max_budget            Decimal?         @db.Decimal(10, 4)
  soft_budget           Decimal?         @db.Decimal(10, 4)
  tpm_limit             BigInt?
  rpm_limit             BigInt?
  max_parallel_requests Int?
  budget_duration       String?          @db.VarChar(50)
  budget_reset_at       DateTime?        @db.Timestamptz(6)
  model_max_budget      Json?
  created_at            DateTime?        @default(now()) @db.Timestamptz(6)
  created_by            String?          @db.VarChar(255)
  updated_at            DateTime?        @default(now()) @db.Timestamptz(6)
  updated_by            String?          @db.VarChar(255)
  organizations         Organization[]
  team_memberships      TeamMembership[]

  @@map("budgets")
}

model ObjectPermission {
  object_permission_id String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  permissions          Json?          @default("{}")
  created_at           DateTime?      @default(now()) @db.Timestamptz(6)
  created_by           String?        @db.VarChar(255)
  updated_at           DateTime?      @default(now()) @db.Timestamptz(6)
  updated_by           String?        @db.VarChar(255)
  organizations        Organization[]
  teams                Team[]
  users                User[]

  @@map("object_permissions")
}

model ModelAlias {
  id         Int       @id @default(autoincrement())
  aliases    Json?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  created_by String?   @db.VarChar(255)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_by String?   @db.VarChar(255)
  teams      Team[]

  @@map("model_aliases")
}

model Tenant {
  tenant_id                  String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                       String                       @unique @db.VarChar(255)
  domain                     String                       @unique @db.VarChar(255)
  status                     String                       @default("active") @db.VarChar(50)
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  model_deployments          ModelDeployment[]
  request_logs               RequestLog[]
  spend_logs                 SpendLog[]
  team_memberships           TeamMembership[]
  tenantAdminInvitations     tenant_admin_invitations[]
  tenant_onboarding_requests tenant_onboarding_requests[]
  tenant_provider_accounts   TenantProviderAccount[]
  tenant_runtime_profiles    tenant_runtime_profiles[]
  tenant_guardrails          TenantGuardrail[]
  verification_tokens        VerificationToken[]
  virtual_users              VirtualUser[]
  virtual_models             virtual_models[]
  wallet_topup_intents       wallet_topup_intents[]
  wallet_transactions        WalletTransaction[]
  wallets                    Wallet?

  @@map("tenants")
}

model Organization {
  organization_id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_alias       String                   @db.VarChar(255)
  budget_id                String?                  @db.Uuid
  metadata                 Json?                    @default("{}")
  models                   String[]                 @default([])
  spend                    Decimal?                 @default(0.0) @db.Decimal(10, 4)
  model_spend              Json?                    @default("{}")
  object_permission_id     String?                  @db.Uuid
  created_at               DateTime?                @default(now()) @db.Timestamptz(6)
  created_by               String?                  @db.VarChar(255)
  updated_at               DateTime?                @default(now()) @db.Timestamptz(6)
  updated_by               String?                  @db.VarChar(255)
  organization_memberships OrganizationMembership[]
  budgets                  Budget?                  @relation(fields: [budget_id], references: [budget_id], onDelete: NoAction, onUpdate: NoAction)
  object_permissions       ObjectPermission?        @relation(fields: [object_permission_id], references: [object_permission_id], onDelete: NoAction, onUpdate: NoAction)
  teams                    Team[]
  users                    User[]
  verification_tokens      VerificationToken[]
  virtual_users            VirtualUser[]

  @@map("organizations")
}

model Team {
  team_id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team_alias                  String?             @db.VarChar(255)
  organization_id             String?             @db.Uuid
  object_permission_id        String?             @db.Uuid
  admins                      String[]            @default([])
  members                     String[]            @default([])
  members_with_roles          Json?               @default("{}")
  metadata                    Json?               @default("{}")
  max_budget                  Decimal?            @db.Decimal(10, 4)
  soft_budget                 Decimal?            @db.Decimal(10, 4)
  spend                       Decimal?            @default(0.0) @db.Decimal(10, 4)
  models                      String[]            @default([])
  max_parallel_requests       Int?
  tpm_limit                   BigInt?
  rpm_limit                   BigInt?
  budget_duration             String?             @db.VarChar(50)
  budget_reset_at             DateTime?           @db.Timestamptz(6)
  blocked                     Boolean?            @default(false)
  model_spend                 Json?               @default("{}")
  model_max_budget            Json?               @default("{}")
  router_settings             Json?               @default("{}")
  team_member_permissions     String[]            @default([])
  access_group_ids            String[]            @default([])
  policies                    String[]            @default([])
  default_team_member_models  String[]            @default([])
  budget_limits               Json?
  model_id                    Int?
  allow_team_guardrail_config Boolean?            @default(false)
  created_at                  DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime?           @default(now()) @db.Timestamptz(6)
  team_memberships            TeamMembership[]
  model_aliases               ModelAlias?         @relation(fields: [model_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  object_permissions          ObjectPermission?   @relation(fields: [object_permission_id], references: [object_permission_id], onDelete: NoAction, onUpdate: NoAction)
  organizations               Organization?       @relation(fields: [organization_id], references: [organization_id], onDelete: NoAction, onUpdate: NoAction)
  users                       User[]
  verification_tokens         VerificationToken[]
  virtual_users               VirtualUser[]

  @@index([team_alias], map: "idx_team_alias")
  @@index([created_at], map: "idx_team_created_at")
  @@index([organization_id], map: "idx_team_org_id")
  @@map("teams")
}

model User {
  user_id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_alias               String?                  @db.VarChar(255)
  email                    String?                  @unique @db.VarChar(255)
  role                     String?                  @default("internal_user") @db.VarChar(50)
  team_id                  String?                  @db.Uuid
  organization_id          String?                  @db.Uuid
  max_budget               Decimal?                 @db.Decimal(10, 4)
  budget_duration          String?                  @db.VarChar(50)
  spend                    Decimal?                 @default(0.0) @db.Decimal(10, 4)
  tpm_limit                BigInt?
  rpm_limit                BigInt?
  metadata                 Json?                    @default("{}")
  object_permission_id     String?                  @db.Uuid
  created_at               DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?                @default(now()) @db.Timestamptz(6)
  organization_memberships OrganizationMembership[]
  team_memberships         TeamMembership[]
  object_permissions       ObjectPermission?        @relation(fields: [object_permission_id], references: [object_permission_id], onDelete: NoAction, onUpdate: NoAction)
  organizations            Organization?            @relation(fields: [organization_id], references: [organization_id], onDelete: NoAction, onUpdate: NoAction)
  teams                    Team?                    @relation(fields: [team_id], references: [team_id], onDelete: NoAction, onUpdate: NoAction)
  verification_tokens      VerificationToken[]

  @@map("users")
}

model OrganizationMembership {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String       @db.Uuid
  user_id         String       @db.Uuid
  role            String?      @default("member") @db.VarChar(50)
  created_at      DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?    @default(now()) @db.Timestamptz(6)
  organizations   Organization @relation(fields: [organization_id], references: [organization_id], onDelete: Cascade, onUpdate: NoAction)
  users           User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, user_id])
  @@index([organization_id], map: "idx_org_memberships_org")
  @@index([user_id], map: "idx_org_memberships_user")
  @@map("organization_memberships")
}

model TeamMembership {
  team_membership_id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id               String   @db.Uuid
  team_id                 String   @db.Uuid
  user_id                 String   @db.Uuid
  role                    String   @default("team_member") @db.VarChar(50)
  team_member_permissions String[] @default([])
  budget_id               String?  @db.Uuid
  spend                   Decimal? @default(0.0) @db.Decimal(10, 4)
  metadata                Json?    @default("{}")
  created_at              DateTime @default(now()) @db.Timestamptz(6)
  updated_at              DateTime @default(now()) @db.Timestamptz(6)
  budgets                 Budget?  @relation(fields: [budget_id], references: [budget_id], onDelete: NoAction, onUpdate: NoAction)
  teams                   Team     @relation(fields: [team_id], references: [team_id], onDelete: Cascade, onUpdate: NoAction)
  tenants                 Tenant   @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction)
  users                   User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([team_id, user_id], map: "uq_team_memberships_team_user")
  @@index([tenant_id], map: "idx_team_memberships_tenant")
  @@index([team_id], map: "idx_team_memberships_team")
  @@index([user_id], map: "idx_team_memberships_user")
  @@map("team_memberships")
}

model VirtualUser {
  virtual_user_id     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String              @db.Uuid
  team_id             String?             @db.Uuid
  org_unit_id         String?             @db.Uuid
  alias               String              @db.VarChar(255)
  display_name        String?             @db.VarChar(255)
  metadata            Json?               @default("{}")
  active              Boolean             @default(true)
  created_at          DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?           @default(now()) @db.Timestamptz(6)
  tenants             Tenant              @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction)
  teams               Team?               @relation(fields: [team_id], references: [team_id], onDelete: SetNull, onUpdate: NoAction)
  organizations       Organization?       @relation(fields: [org_unit_id], references: [organization_id], onDelete: SetNull, onUpdate: NoAction)
  verification_tokens VerificationToken[]

  @@unique([tenant_id, alias], map: "uq_virtual_users_tenant_alias")
  @@index([tenant_id], map: "idx_virtual_users_tenant_id")
  @@index([team_id], map: "idx_virtual_users_team_id")
  @@index([org_unit_id], map: "idx_virtual_users_org_unit_id")
  @@map("virtual_users")
}

model VerificationToken {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token_hash            String        @unique @db.VarChar(64)
  key_alias             String?       @db.VarChar(255)
  key_name              String?       @db.VarChar(255)
  team_id               String?       @db.Uuid
  user_id               String?       @db.Uuid
  organization_id       String?       @db.Uuid
  virtual_user_id       String?       @db.Uuid
  models                String[]      @default([])
  max_budget            Decimal?      @db.Decimal(10, 4)
  soft_budget           Decimal?      @db.Decimal(10, 4)
  tpm_limit             BigInt?
  rpm_limit             BigInt?
  max_parallel_requests Int?
  budget_duration       String?       @db.VarChar(50)
  budget_reset_at       DateTime?     @db.Timestamptz(6)
  spend                 Decimal?      @default(0.0) @db.Decimal(10, 4)
  expires               DateTime?     @db.Timestamptz(6)
  blocked               Boolean?      @default(false)
  metadata              Json?         @default("{}")
  created_at            DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?     @default(now()) @db.Timestamptz(6)
  tenant_id             String?       @db.Uuid
  created_by_user_id    String?
  last_used_at          DateTime?     @db.Timestamptz(6)
  revoked_at            DateTime?     @db.Timestamptz(6)
  revoked_by_user_id    String?
  key_type              String?       @db.VarChar(16)
  rotated_from_token_id String?       @db.Uuid
  rotation_grace_expires_at DateTime? @db.Timestamptz(6)
  revoked_reason        String?
  organizations         Organization? @relation(fields: [organization_id], references: [organization_id], onDelete: NoAction, onUpdate: NoAction)
  rotated_from_token    VerificationToken? @relation("TokenRotation", fields: [rotated_from_token_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  rotated_tokens        VerificationToken[] @relation("TokenRotation")
  teams                 Team?         @relation(fields: [team_id], references: [team_id], onDelete: NoAction, onUpdate: NoAction)
  tenants               Tenant?       @relation(fields: [tenant_id], references: [tenant_id], onDelete: NoAction, onUpdate: NoAction)
  users                 User?         @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  virtual_users         VirtualUser?  @relation(fields: [virtual_user_id], references: [virtual_user_id], onDelete: SetNull, onUpdate: NoAction)

  @@index([key_type], map: "idx_vt_key_type")
  @@index([tenant_id], map: "idx_verification_tokens_tenant_id")
  @@index([organization_id], map: "idx_vt_org")
  @@index([team_id], map: "idx_vt_team")
  @@index([tenant_id, key_type], map: "idx_vt_tenant_key_type")
  @@index([tenant_id, revoked_at], map: "idx_vt_tenant_revoked_at")
  @@index([tenant_id, virtual_user_id], map: "idx_vt_tenant_virtual_user")
  @@index([token_hash], map: "idx_vt_token_hash")
  @@index([user_id], map: "idx_vt_user")
  @@map("verification_tokens")
}

model ModelDeployment {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  model_name           String    @db.VarChar(255)
  provider             String    @db.VarChar(50)
  model                String    @db.VarChar(255)
  provider_config      Json
  model_info           Json?
  rpm                  BigInt?
  tpm                  BigInt?
  timeout              Float?
  stream_timeout       Float?
  health_check_timeout Int?      @default(60)
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @default(now()) @db.Timestamptz(6)
  tenant_id            String?   @db.Uuid
  tenants              Tenant?   @relation(fields: [tenant_id], references: [tenant_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenant_id], map: "idx_model_deployments_tenant_id")
  @@index([model_name], map: "idx_model_name")
  @@map("model_deployments")
}

model Credential {
  credential_id     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  credential_name   String    @unique @db.VarChar(255)
  credential_values Json
  credential_info   Json?
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  created_by        String?   @db.VarChar(255)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_by        String?   @db.VarChar(255)

  @@map("credentials")
}

model SpendLog {
  id                    BigInt    @id @default(autoincrement())
  token_hash            String?   @db.VarChar(64)
  team_id               String?   @db.Uuid
  user_id               String?   @db.Uuid
  organization_id       String?   @db.Uuid
  model                 String?   @db.VarChar(255)
  input_tokens          Int?
  output_tokens         Int?
  total_tokens          Int?
  cost                  Decimal?  @db.Decimal(10, 6)
  response_time_ms      Int?
  status                String?   @db.VarChar(20)
  completion_start_time DateTime? @db.Timestamptz(6)
  completion_end_time   DateTime? @db.Timestamptz(6)
  request_tags          String[]
  request_metadata      Json?
  created_at            DateTime? @default(now()) @db.Timestamptz(6)
  tenant_id             String?   @db.Uuid
  request_id            String?   @db.VarChar(255)
  cost_usd              Decimal?  @db.Decimal(10, 6)
  cost_irr              Decimal?  @db.Decimal(18, 2)
  tenants               Tenant?   @relation(fields: [tenant_id], references: [tenant_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "idx_spend_created")
  @@index([organization_id], map: "idx_spend_org")
  @@index([team_id], map: "idx_spend_team")
  @@index([token_hash], map: "idx_spend_token")
  @@index([user_id], map: "idx_spend_user")
  @@map("spend_logs")
}

model RequestLog {
  id               BigInt    @id @default(autoincrement())
  request_id       String?   @db.VarChar(255)
  token_hash       String?   @db.VarChar(64)
  team_id          String?   @db.Uuid
  user_id          String?   @db.Uuid
  model            String?   @db.VarChar(255)
  request_body     Json?
  response_body    Json?
  status           String?   @db.VarChar(20)
  cost             Decimal?  @db.Decimal(10, 6)
  response_time_ms Int?
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  tenant_id        String?   @db.Uuid
  tenants          Tenant?   @relation(fields: [tenant_id], references: [tenant_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("request_logs")
}

model Guardrail {
  guardrail_name        String    @id @db.VarChar(255)
  guardrail_type        String?   @db.VarChar(50)
  event_hook            String?   @db.VarChar(50)
  guardrail_init_kwargs Json?     @default("{}")
  created_at            DateTime? @default(now()) @db.Timestamptz(6)
  updated_at            DateTime? @default(now()) @db.Timestamptz(6)

  @@map("guardrails")
}

model TenantGuardrail {
  guardrail_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String    @db.Uuid
  slug           String    @db.VarChar(96)
  name           String    @db.VarChar(255)
  description    String?
  guardrail_type String    @db.VarChar(64)
  operation      String    @default("validate") @db.VarChar(32)
  enforcement    String    @default("enforce") @db.VarChar(32)
  enabled        Boolean   @default(true)
  config_json    Json      @default("{}")
  created_by     String?   @db.VarChar(255)
  updated_by     String?   @db.VarChar(255)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)
  tenants        Tenant    @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, slug], map: "uq_tenant_guardrails_tenant_slug")
  @@index([tenant_id], map: "idx_tenant_guardrails_tenant")
  @@index([tenant_id, enabled], map: "idx_tenant_guardrails_tenant_enabled")
  @@map("tenant_guardrails")
}

model Policy {
  policy_id     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policy_name   String    @unique @db.VarChar(255)
  policy_type   String?   @db.VarChar(50)
  policy_config Json
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@map("policies")
}

model Wallet {
  wallet_id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String              @unique @db.Uuid
  balance_irr         Float               @default(0)
  pending_irr         Float               @default(0)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime            @default(now()) @db.Timestamptz(6)
  wallet_transactions WalletTransaction[]
  tenants             Tenant              @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("wallets")
}

model WalletTransaction {
  transaction_id       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wallet_id            String                 @db.Uuid
  tenant_id            String                 @db.Uuid
  tx_type              String                 @db.VarChar(50)
  amount_irr           Float
  amount_usd           Float?
  exchange_rate        Float?
  status               String                 @db.VarChar(50)
  description          String?
  metadata             Json?                  @default("{}")
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  wallet_topup_intents wallet_topup_intents[]
  tenants              Tenant                 @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction)
  wallets              Wallet                 @relation(fields: [wallet_id], references: [wallet_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id], map: "idx_wallet_transactions_tenant_id")
  @@map("wallet_transactions")
}

model ExchangeRate {
  rate_id    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usd_to_irr Float
  source     String   @db.VarChar(255)
  fetched_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([fetched_at(sort: Desc)], map: "idx_exchange_rates_fetched_at")
  @@map("exchange_rates")
}

model ExchangeRateCurrent {
  rate_id    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source     String   @unique @db.VarChar(255)
  symbol     String?  @db.VarChar(64)
  usd_to_irr Float
  fetched_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([fetched_at(sort: Desc)], map: "idx_exchange_rate_current_fetched_at")
  @@map("exchange_rate_current")
}

model TenantProviderAccount {
  account_id                     String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                      String                        @db.Uuid
  provider                       String                        @db.VarChar(100)
  name                           String                        @db.VarChar(255)
  auth_mode                      String                        @db.VarChar(50)
  provider_config                Json                          @default("{}")
  credential_data                Json?
  has_credential                 Boolean                       @default(false)
  use_platform_managed_credentials        Boolean                       @default(false)
  created_at                     DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                      @default(now()) @db.Timestamptz(6)
  tenant_provider_account_access TenantProviderAccountAccess[]
  tenant_provider_account_models TenantProviderAccountModel[]
  tenants                        Tenant                        @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, name], map: "uq_tenant_provider_accounts_tenant_name")
  @@index([tenant_id], map: "idx_tenant_provider_accounts_tenant_id")
  @@index([tenant_id, provider], map: "idx_tenant_provider_accounts_tenant_provider")
  @@map("tenant_provider_accounts")
}

model TenantProviderAccountModel {
  account_model_id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id               String                @db.Uuid
  model                    String                @db.VarChar(255)
  enabled                  Boolean               @default(true)
  types                    String[]              @default([])
  pricing_mode             String                @default("public") @db.VarChar(20)
  private_pricing          Json?
  settings                 Json                  @default("{}")
  created_at               DateTime              @default(now()) @db.Timestamptz(6)
  updated_at               DateTime              @default(now()) @db.Timestamptz(6)
