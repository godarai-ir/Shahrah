{
  "name": "@shahrah/database",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "prisma:generate": "prisma generate --schema=./schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=./schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=./schema.prisma",
    "prisma:pull": "prisma db pull --schema=./schema.prisma",
    "prisma:studio": "prisma studio --schema=./schema.prisma",
    "prisma:validate": "prisma validate --schema=./schema.prisma",
    "sync": "node scripts/sync-prisma.js"
  },
  "devDependencies": {
    "prisma": "^7.8.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.20.0"
  },
  "peerDependencies": {
    "@prisma/client": "^7.8.0",
    "prisma": "^7.8.0"
  }
}