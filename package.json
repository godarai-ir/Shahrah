{
  "name": "shahrah",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @shahrah/tenant-admin dev",
    "dev:model-discovery": "pnpm --filter model-discovery start:dev",
    "dev:model-discovery-web": "pnpm --filter @shahrah/model-discovery-web dev",
    "dev:support-admin": "pnpm --filter @shahrah/support-admin dev",
    "dev:all": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.9.6"
  },
  "version": "1.0.0",
  "description": "Shahrah is now organized as a monorepo for the full platform: control plane, tunnel services, admin panels, docs, blog, SDKs, shared contracts, and infrastructure.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Delpak/Shahrah.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Delpak/Shahrah/issues"
  },
  "homepage": "https://github.com/Delpak/Shahrah#readme"
}
