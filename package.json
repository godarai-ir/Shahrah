{
  "name": "shahrah",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "brand:sync": "node scripts/sync-brand-assets.mjs",
    "brand:check": "node scripts/sync-brand-assets.mjs --check",
    "build": "turbo run build",
    "build:affected": "turbo run build --affected",
    "clean:stale": "node scripts/clean-workspace.mjs stale",
    "clean:cache": "node scripts/clean-workspace.mjs cache",
    "clean:next": "node scripts/clean-workspace.mjs next",
    "clean:temp": "node scripts/clean-workspace.mjs temp",
    "clean:all": "node scripts/clean-workspace.mjs all",
    "clean:prune": "node scripts/clean-workspace.mjs prune",
    "reference:check": "node scripts/check-reference-markdown.mjs",
    "dev": "turbo run dev --parallel --filter=@shahrah/website --filter=@shahrah/tenant-admin",
    "dev:model-discovery": "pnpm --filter model-discovery start:dev",
    "dev:model-discovery-web": "pnpm --filter @shahrah/model-discovery-web dev",
    "dev:support-admin": "pnpm --filter @shahrah/support-admin dev",
    "dev:all": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:affected": "turbo run lint --affected",
    "test": "turbo run test",
    "test:affected": "turbo run test --affected"
  },
  "devDependencies": {
    "turbo": "^2.9.6"
  },
  "version": "1.0.0",
  "description": "Shahrah is now organized as a monorepo for the full platform: control plane, tunnel services, admin panels, docs, blog, SDKs, shared contracts, and infrastructure.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Delpak/Shahrah.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Delpak/Shahrah/issues"
  },
  "homepage": "https://github.com/Delpak/Shahrah#readme"
}
